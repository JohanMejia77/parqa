@startuml componentes
!theme plain
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #1C2130
}
skinparam node {
  BackgroundColor #F4F6FA
  BorderColor #1C2130
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #1C2130
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #1C2130
}
title Diagrama de componentes — Autos Colombia (iteraciones 1 y 2)

node "Equipo del usuario" {
  component "Navegador web" as nav
  component "Cliente HTTP\n(pruebas o integraciones)" as http #FFF6CC
}

interface "HTTP\n(páginas)" as iWeb
interface "HTTP + JSON\n(/api/...)" as iApi

node "Servidor de aplicación · Next.js 16 sobre Node.js" {
  component "Proxy (proxy.ts)\nsin cookie de sesión: a /login" as proxy #FFF6CC

  package "Presentación (app/, components/)" as Presentacion {
    component "Inicio de sesión\n/login" as pagLogin #FFF6CC
    component "Páginas del administrador\nUsuarios, Celdas" as pagAd #FFF6CC
    component "Páginas del operador\nPanel, Entrada, Salida, Historial" as pagOp
    component "Componentes de interfaz\nformularios, diálogos, tablas" as ui
  }

  package "Controladores" as Controladores {
    component "Server Actions\n(acciones/)" as acciones
    component "API REST\n(app/api/)" as api #FFF6CC
  }

  package "Lógica de negocio (servicios/)" as Negocio {
    component "UsuarioServicio" as sUsu #FFF6CC
    component "CeldaServicio" as sCel #FFF6CC
    component "ParqueaderoServicio\nentradas y salidas" as sPar
    component "AutenticacionServicio\nsesiones y autorización por rol" as sAut #FFF6CC
  }

  package "Acceso a datos (repositorios/)" as Datos {
    component "UsuarioRepositorio" as rUsu #FFF6CC
    component "SesionRepositorio" as rSes #FFF6CC
    component "CeldaRepositorio" as rCel
    component "VehiculoRepositorio" as rVeh
    component "RegistroRepositorio" as rReg
    component "Conexión\n(pool pg, transacciones)" as con
  }

  component "Modelos del dominio\n(modelos/)" as modelos
}

interface "SQL\n(TCP 5432)" as iSql

database "PostgreSQL · base autos_colombia" as bd {
  component "usuario" as tUsu #FFF6CC
  component "sesion" as tSes #FFF6CC
  component "celda" as tCel
  component "vehiculo" as tVeh
  component "registro" as tReg
}

nav --( iWeb
http --( iApi
iWeb -- proxy
iApi -- api
proxy --> Presentacion

pagLogin ..> ui
pagAd ..> ui
pagOp ..> ui
ui --> acciones : envía\nformularios
Presentacion --> sAut : usuario actual
pagAd --> Negocio : consultas
pagOp --> Datos : consultas

acciones --> Negocio
api --> Negocio

sUsu ..> sAut : autorizar
sCel ..> sAut : autorizar
sPar ..> sAut : autorizar

sAut --> rUsu
sAut --> rSes
sUsu --> rUsu
sCel --> rCel
sPar --> rCel
sPar --> rVeh
sPar --> rReg

rUsu --> con
rSes --> con
rCel --> con
rVeh --> con
rReg --> con

Negocio ..> modelos
Datos ..> modelos

con --( iSql
iSql -- bd

legend right
  |= Color |= Significado |
  | <#FFFFFF>      | Componente de la iteración 1 |
  | <#FFF6CC>      | Componente nuevo en la iteración 2 |
  CeldaRepositorio y la tabla celda existen desde la iteración 1;
  la iteración 2 les añade crear, editar y eliminar.
endlegend
@enduml
