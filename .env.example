# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
# Ajusta el usuario y la contraseña a los de tu instalación de PostgreSQL.
# La base "autos_colombia" se crea sola al ejecutar: npm run db:setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_colombia

# Cuenta inicial de administrador. La crea "npm run db:setup" cuando todavía no hay
# ningún administrador. Con ella se inicia sesión la primera vez y se crean las demás cuentas.
# Cambia la contraseña antes de ejecutar db:setup (mínimo 8 caracteres).
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=autos-colombia-2026
